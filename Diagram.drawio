  <diagram id="m91chnyRUUOVvKTH--L2" name="Hybrid Database Architecture Diagram">
    <mxGraphModel dx="2156" dy="946" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n    USER[\&quot;E-commerce User\&quot;]\n\n    APP[\&quot;Python Application Layer&lt;br/&gt;Hybrid CRUD &amp; Query Application\&quot;]\n\n    SQL[\&quot;MySQL Database&lt;br/&gt;ecommerce_hybrid\&quot;]\n\n    NOSQL[\&quot;MongoDB Database&lt;br/&gt;ecommerce_nosql\&quot;]\n\n    subgraph MYSQL[\&quot;SQL Layer - Structured Transactional Data\&quot;]\n\n        CUST[\&quot;customers\&quot;]\n        CAT[\&quot;categories\&quot;]\n        PREF[\&quot;product_reference\&quot;]\n        ORD[\&quot;orders\&quot;]\n        ITEMS[\&quot;order_items\&quot;]\n        PAY[\&quot;payments\&quot;]\n        INV[\&quot;inventory\&quot;]\n\n        CUST --&gt; ORD\n        CAT --&gt; PREF\n        ORD --&gt; ITEMS\n        ORD --&gt; PAY\n        PREF --&gt; ITEMS\n        PREF --&gt; INV\n    end\n\n    subgraph MONGO[\&quot;NoSQL Layer - Semi-structured / Unstructured Data\&quot;]\n\n        PROD[\&quot;products\&quot;]\n        REV[\&quot;reviews\&quot;]\n        ACT[\&quot;customer_activity\&quot;]\n\n        PROD --&gt; REV\n        PROD --&gt; ACT\n    end\n\n    USER --&gt; APP\n\n    APP --&gt;|\&quot;SQL CRUD / JOIN / Aggregation\&quot;| SQL\n    APP --&gt;|\&quot;MongoDB CRUD / Aggregation\&quot;| NOSQL\n\n    SQL --&gt; MYSQL\n    NOSQL --&gt; MONGO\n\n    PREF -. \&quot;Logical product_id link\&quot; .-&gt; PROD\n    ITEMS -. \&quot;Logical product_id link\&quot; .-&gt; PROD\n\n    REV -. \&quot;customer_id\&quot; .-&gt; CUST\n    ACT -. \&quot;customer_id\&quot; .-&gt; CUST&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="SLA4sV8lHSkNon2x6Dsr-1">
