        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    CUSTOMERS {\n        BIGINT_UNS customer_id PK\n        VARCHAR first_name\n        VARCHAR last_name\n        VARCHAR email UK\n        VARCHAR phone\n        DATE registration_date\n        VARCHAR city\n        VARCHAR country\n    }\n\n    CATEGORIES {\n        BIGINT_UNS category_id PK\n        VARCHAR category_name UK\n        TEXT description\n    }\n\n    PRODUCT_REFERENCE {\n        BIGINT_UNS product_id PK\n        BIGINT_UNS category_id FK\n        VARCHAR sku UK\n        BOOLEAN active\n    }\n\n    ORDERS {\n        BIGINT_UNS order_id PK\n        BIGINT_UNS customer_id FK\n        TIMESTAMP order_date\n        VARCHAR order_status\n        DECIMAL total_amount\n    }\n\n    ORDER_ITEMS {\n        BIGINT_UNS order_item_id PK\n        BIGINT_UNS order_id FK\n        BIGINT_UNS product_id\n        INT quantity\n        DECIMAL unit_price\n    }\n\n    PAYMENTS {\n        BIGINT_UNS payment_id PK\n        BIGINT_UNS order_id FK\n        VARCHAR payment_method\n        VARCHAR payment_status\n        TIMESTAMP payment_date\n        DECIMAL amount\n    }\n\n    INVENTORY {\n        BIGINT_UNS inventory_id PK\n        BIGINT_UNS product_id\n        INT stock_quantity\n        INT reorder_level\n        TIMESTAMP last_updated\n    }\n\n    CUSTOMERS ||--o{ ORDERS : \&quot;places\&quot;\n\n    ORDERS ||--|{ ORDER_ITEMS : \&quot;contains\&quot;\n\n    ORDERS ||--o{ PAYMENTS : \&quot;has\&quot;\n\n    CATEGORIES ||--o{ PRODUCT_REFERENCE : \&quot;classifies\&quot;\n\n    PRODUCT_REFERENCE ||--o| INVENTORY : \&quot;has\&quot;\n\n    PRODUCT_REFERENCE ||--o{ ORDER_ITEMS : \&quot;referenced by\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CSWZiuk4siSW2dO_qg20-1">
